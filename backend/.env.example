# Database
DATABASE_URL=postgresql://conference_user:conference_password@postgres:5432/conference_db?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=http://frontend:80
CORS_ORIGIN=http://frontend:80

# OAuth (optional - fill in for production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# API Keys (optional - fill in for production)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

