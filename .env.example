# ==================================================
# VIRTUAL CONFERENCE TRANSLATOR & SUMMARIZER
# Environment Variables Configuration
# ==================================================

# ------------------------------
# SERVER CONFIGURATION
# ------------------------------
PORT=3001
NODE_ENV=development

# Frontend URL for redirects and CORS
FRONTEND_URL=http://localhost:5173

# ------------------------------
# DATABASE CONFIGURATION
# ------------------------------
# SQLite (Default)
DATABASE_URL="file:./dev.db"

# PostgreSQL (Optional - for production)
# DATABASE_URL="postgresql://username:password@localhost:5432/virtual_conference"

# ------------------------------
# JWT CONFIGURATION
# ------------------------------
# Generate a secure random string for JWT signing
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secure_jwt_secret_key_here

# JWT expiration time
JWT_EXPIRES_IN=7d

# ------------------------------
# EMAIL CONFIGURATION (Nodemailer)
# ------------------------------
# SMTP Configuration for sending verification emails

# Gmail SMTP (Recommended for development)
# 1. Enable 2FA on your Gmail account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Alternative SMTP providers:
# Outlook/Hotmail: smtp-mail.outlook.com
# Yahoo: smtp.mail.yahoo.com
# Custom SMTP: your_smtp_host.com

# Email sender information
EMAIL_FROM_NAME="Virtual Conference Team"
EMAIL_FROM_ADDRESS=noreply@virtualconference.com

# ------------------------------
# OAUTH CONFIGURATION
# ------------------------------
# Google OAuth Setup:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials
# 5. Add authorized redirect URIs: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# GitHub OAuth Setup:
# 1. Go to https://github.com/settings/applications/new
# 2. Create a new OAuth App
# 3. Set Authorization callback URL: http://localhost:3001/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# ------------------------------
# FRONTEND CONFIGURATION
# ------------------------------
# Backend API URL for frontend requests
REACT_APP_BACKEND_URL=http://localhost:3001

# ------------------------------
# PRODUCTION DEPLOYMENT NOTES
# ------------------------------
# For production deployment, update:
# 1. FRONTEND_URL to your production domain
# 2. DATABASE_URL to production database
# 3. JWT_SECRET to a secure random string
# 4. All SMTP credentials to production email service
# 5. OAuth callback URLs to production domain
# 6. Enable HTTPS/SSL certificates
# 7. Set NODE_ENV=production
# 8. Configure proper CORS settings

# ------------------------------
# SECURITY BEST PRACTICES
# ------------------------------
# 1. Never commit .env files to version control
# 2. Use strong, unique secrets for JWT and OAuth
# 3. Enable 2FA on email service accounts
# 4. Use environment-specific configurations
# 5. Regularly rotate secrets and tokens
# 6. Monitor for unauthorized access attempts
# 7. Use HTTPS in production
# 8. Implement rate limiting
# 9. Set up proper logging and monitoring

# ------------------------------
# DEVELOPMENT SETUP COMMANDS
# ------------------------------
# 1. Copy this file to .env in both backend and frontend directories
# 2. Fill in all required values
# 3. Install dependencies: npm install
# 4. Run database migrations: npx prisma migrate dev
# 5. Start backend: npm run dev (in backend directory)
# 6. Start frontend: npm run dev (in frontend directory)
